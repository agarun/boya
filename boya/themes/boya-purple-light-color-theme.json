      "scope": "meta.class entity.name.type.class.tsx",
      "settings": {
        "foreground": "#111111"
      }
    },
    {
      "name": "TypeScript Entity Name Type",
      "scope": [
        "entity.name.type.tsx",
        "entity.name.type.module.tsx"
      ],
      "settings": {
        "foreground": "#111111"
      }
    },
    {
      "name": "TypeScript Class Variable Keyword",
