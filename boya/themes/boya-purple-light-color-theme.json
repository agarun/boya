  "tokenColors": [
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "meta.diff.header.git",
        "meta.diff.header.from-file",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#7fc1ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted.diff",
      "settings": {
        "foreground": "#ff004590",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted.diff",
      "settings": {
        "foreground": "#0071ffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Global settings",
      "settings": {
        "background": "#001730",
        "foreground": "#3b3e5e"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
